# Copy to .env and fill in YOUR OWN values. .env is gitignored. Never commit real keys.

# Database (docker-compose maps Postgres to host port 5435)
DATABASE_URL=postgresql+psycopg://support:support@localhost:5435/support_agent

# LLM. "fake" (default) uses the deterministic scripted FakeLLM and costs nothing.
# "anthropic" calls the real API and costs money. Only set it on purpose.
LLM_PROVIDER=fake
LLM_MODEL=claude-haiku-5-5
LLM_PRICE_INPUT_PER_MTOK=0.10
LLM_PRICE_OUTPUT_PER_MTOK=0.50
ANTHROPIC_API_KEY=

# Payments. "fake" (default) or "stripe". StripeGateway refuses anything that is not sk_test_...
PAYMENT_PROVIDER=fake
STRIPE_SECRET_KEY=sk_test_replace_me

# Email goes to MailHog only (SMTP 1025, UI http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=support@example.com
MAIL_ALLOWED_DOMAINS=example.com

# Policy knobs (see POLICY.md)
REFUND_WINDOW_DAYS=30
AUTO_APPROVE_LIMIT_CENTS=10000
TICKET_REFUND_CAP_CENTS=100000
# Frozen store clock so seed data and scenarios stay stable over time
STORE_NOW=2026-11-01T12:00:00+00:00

# Agent
MAX_STEPS=12
REQUIRE_POLICY_CHECK=0

# Admin page basic auth
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Tracing: console spans, or OTLP if an endpoint is set
OTEL_CONSOLE=0
OTEL_EXPORTER_OTLP_ENDPOINT=
